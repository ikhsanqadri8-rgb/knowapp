{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access for teachers and students",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["teacher", "student"] },
        "educatorCodeVerified": { "type": "boolean" },
        "schoolName": { "type": "string", "maxLength": 150 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "displayName", "role", "createdAt"]
    },
    "SchoolClass": {
      "title": "SchoolClass",
      "description": "Vocational classroom managed by teacher",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "gradeLevel": { "type": "string", "maxLength": 50 },
        "major": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "joinCode": { "type": "string", "maxLength": 10 },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "teacherId", "teacherName", "name", "gradeLevel", "major", "joinCode", "isArchived", "createdAt"]
    },
    "ClassMember": {
      "title": "ClassMember",
      "description": "Student enrollment in a class",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string", "maxLength": 100 },
        "studentEmail": { "type": "string", "format": "email" },
        "status": { "type": "string", "enum": ["active", "removed"] },
        "joinedAt": { "type": "string" }
      },
      "required": ["id", "classId", "studentId", "studentName", "studentEmail", "status", "joinedAt"]
    },
    "AssessmentSession": {
      "title": "AssessmentSession",
      "description": "Teacher controlled diagnostic assessment session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "teacherId": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "contentPackId": { "type": "string" },
        "selectedMissionIds": { "type": "array" },
        "status": { "type": "string", "enum": ["draft", "scheduled", "active", "paused", "closed", "archived"] },
        "allowHints": { "type": "boolean" },
        "maxAttempts": { "type": "number" },
        "scheduledStartTime": { "type": "string" },
        "deadlineTime": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "classId", "teacherId", "name", "contentPackId", "status", "allowHints", "maxAttempts", "createdAt"]
    },
    "AssessmentResponse": {
      "title": "AssessmentResponse",
      "description": "Individual student submission for a mission within an assessment session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "classId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string", "maxLength": 100 },
        "missionId": { "type": "string" },
        "dimension": { "type": "string" },
        "answers": { "type": "object" },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "hintsUsed": { "type": "number" },
        "attemptsCount": { "type": "number" },
        "timeSpentSeconds": { "type": "number" },
        "completedAt": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "sessionId", "classId", "studentId", "studentName", "missionId", "dimension", "score", "maxScore", "hintsUsed", "attemptsCount", "timeSpentSeconds", "completedAt"]
    },
    "StudentLearningProfile": {
      "title": "StudentLearningProfile",
      "description": "Aggregated diagnostic profile across dimensions for a student in a class",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string", "maxLength": 100 },
        "classId": { "type": "string" },
        "priorKnowledgeScorePercent": { "type": "number" },
        "priorKnowledgeStatus": { "type": "string" },
        "interestsSummary": { "type": "array" },
        "preferredActivities": { "type": "array" },
        "supportNeeds": { "type": "array" },
        "totalMissionsCompleted": { "type": "number" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["id", "studentId", "studentName", "classId", "priorKnowledgeScorePercent", "priorKnowledgeStatus", "totalMissionsCompleted", "lastUpdated"]
    },
    "StoredAIRecommendation": {
      "title": "StoredAIRecommendation",
      "description": "AI-generated differentiation and TaRL scaffolding advice for teachers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "classId": { "type": "string" },
        "teacherId": { "type": "string" },
        "data": { "type": "object" },
        "teacherNotes": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "reviewed", "applied"] },
        "generatedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "sessionId", "classId", "teacherId", "data", "status", "generatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents keyed by Firebase Auth UID"
    },
    "/classes/{classId}": {
      "schema": "SchoolClass",
      "description": "Classes created and managed by teachers"
    },
    "/members/{memberId}": {
      "schema": "ClassMember",
      "description": "Enrollment records connecting students to classes"
    },
    "/sessions/{sessionId}": {
      "schema": "AssessmentSession",
      "description": "Diagnostic assessment sessions per class"
    },
    "/responses/{responseId}": {
      "schema": "AssessmentResponse",
      "description": "Student mission response submissions"
    },
    "/profiles/{profileId}": {
      "schema": "StudentLearningProfile",
      "description": "Aggregated diagnostic profiles per student in a class"
    },
    "/recommendations/{recId}": {
      "schema": "StoredAIRecommendation",
      "description": "Stored pedagogical differentiation recommendations generated by AI"
    }
  }
}
